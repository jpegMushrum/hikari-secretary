# Корневая конфигурация production или bot-local.
# Для локального стенда используйте токен тестового бота.

TELEGRAM_BOT_TOKEN=123456:replace_me
ADMIN_IDS=111111111,222222222
TIMEZONE=Europe/Moscow

# Эти пути являются путями внутри контейнера bot.
MEDIA_DIR=/app/data/media
TARGETS_PATH=/app/targets.json

SCHEDULER_INTERVAL_SECONDS=5
MAX_DELIVERY_ATTEMPTS=5
REMINDER_OPTIONS_MINUTES=30,60,120,360,1440

# ИИ-материалы опциональны в production и bot-local. DeepSeek вызывает backend.
# При заполненном ключе укажите цель из targets.json. Для bot-local выберите
# тестовую цель. Пустое время оставляет доступной только ручную генерацию.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=90
AI_TOPIC_TARGET_KEY=
AI_TOPIC_AUTO_PUBLISH_TIME=
AI_TOPIC_QUESTION_COUNT=5
AI_TOPIC_VOCABULARY_COUNT=10
AI_TOPIC_GRAMMAR_COUNT=3

# BOT_SERVICE_TOKEN задайте тем же значением в backend/.env.
# В корневом Compose BACKEND_URL автоматически равен http://backend:8080.
BACKEND_URL=
BOT_SERVICE_TOKEN=

# Optional HTTPS origin of the miniapp, no trailing route/query. Empty keeps bot-only flow.
MINIAPP_URL=

# В production false приостанавливает фоновые задания бота. bot-local задаёт true в Compose.
BOT_BACKGROUND_WORKERS_ENABLED=true

# Standalone production: docker-compose.production.yml.
# Set journald on the Linux VPS to enable collection by hikari-logs@.timer.
# S3 credentials belong in /etc/hikari-archive/settings.
# HIKARI_LOG_DRIVER=journald
# Deploy production записывает BACKEND_IMAGE, BOT_IMAGE и MINIAPP_IMAGE в .env
# при выпуске. Для первой сборки из исходников оставьте их незаданными.
# Внешний URL строится из MINIAPP_DOMAIN и MINIAPP_HTTPS_PORT.
MINIAPP_DOMAIN=hikari.jpegmushrum.ru
MINIAPP_HTTP_PORT=880
MINIAPP_HTTPS_PORT=8443
MINIAPP_BIND_ADDRESS=0.0.0.0
# Directory containing fullchain.pem and privkey.pem (real files, not broken symlinks).
MINIAPP_TLS_DIR=./data-tls
# Original SQLite directory, mounted read-only by legacy-snapshot in the legacy-import profile.
LEGACY_DATA_DIR=./data
# Shared runtime media directory; preserve the old bot's media files and paths.
BOT_DATA_DIR=./data

# Local backend database in the existing hikari-miniapp-dev PostgreSQL volume.
LOCAL_DATABASE_NAME=hikari_bot_local_20261117
