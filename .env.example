# Корневая конфигурация текущего запуска bot/docker-compose.yml.
# После выделения bot в отдельный репозиторий используйте bot/.env.example.

TELEGRAM_BOT_TOKEN=123456:replace_me
ADMIN_IDS=111111111,222222222
TIMEZONE=Europe/Moscow

# Эти пути являются путями внутри контейнера bot.
DATABASE_PATH=/app/data/bot.sqlite3
MEDIA_DIR=/app/data/media
TARGETS_PATH=/app/targets.json

SCHEDULER_INTERVAL_SECONDS=5
MAX_DELIVERY_ATTEMPTS=5
REMINDER_OPTIONS_MINUTES=30,60,120,360,1440

# AI-материалы — опционально.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=90
AI_TOPIC_TARGET_KEY=
AI_TOPIC_AUTO_PUBLISH_TIME=
AI_TOPIC_QUESTION_COUNT=5
AI_TOPIC_VOCABULARY_COUNT=10
AI_TOPIC_GRAMMAR_COUNT=3

# BOT_SERVICE_TOKEN задайте тем же значением в backend/.env.
# В корневом Compose BACKEND_URL автоматически равен http://backend:8080.
# Для автономного bot Compose на Docker Desktop используйте:
# BACKEND_URL=http://host.docker.internal:8080
BACKEND_URL=
BOT_SERVICE_TOKEN=
