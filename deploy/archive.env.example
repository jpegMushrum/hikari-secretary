# systemd EnvironmentFile: /etc/hikari-archive/settings (root:root, 0600).
HIKARI_S3_URI=s3://your-private-bucket/hikari-production
AWS_DEFAULT_REGION=us-east-1
# Custom S3 provider only. Set region and endpoint supplied by the provider.
# AWS_ENDPOINT_URL=https://s3.example.org
# Leave keys unset when using a host IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
