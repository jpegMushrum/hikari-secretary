# Copy to /etc/hikari-mascot/settings on the VPS and restrict file permissions.
# Use the existing private bucket and a dedicated key scoped to the media prefix.
# The backend needs GetObject, PutObject and DeleteObject under that prefix.
MASCOT_S3_ENDPOINT=https://storage.yandexcloud.net
MASCOT_S3_REGION=ru-central1
MASCOT_S3_BUCKET=
MASCOT_S3_PREFIX=hikari-production/media/mascot
MASCOT_S3_ACCESS_KEY_ID=
MASCOT_S3_SECRET_ACCESS_KEY=
